<div id="destroy">
  <h3><%= email.object %></h3>
  <p><%= email.body %></p>
  <div class="btn-group">
    <a href="<%= email_path(email.id) %>" class="btn btn-primary" data-confirm='Are you sure ?' data-method='delete' data-remote="true">Supprimer</a>
    <a href="<%= email_path(email.id) %>" data-method='put' data-remote="true">Marquer comme non-lu</a>
  </div>
</div>