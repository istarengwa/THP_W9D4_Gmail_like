<div id="<%= email.id %>" class="card text-white mb-3 <%= email.read == true ? "read border-success" : "border-warning" %>">
  <div class="card-header">
    <p style="text-decoration: none">Objet : <%= link_to(email.object,email_path(email), remote: true) %></p>
  </div>
  <div class="card-body">
    <p ><%= email.body %></p>
  </div>
</div>